@model ToDoList
@{
    ViewData["Title"] = "Yapılacaklar Güncelle";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="content"><div class="container-fluid"><h1 class="page-title">@ViewData["Title"]</h1>
<div class="card"><div class="card-body">
<form asp-action="UpdateToDoList" method="post">
<input type="hidden" asp-for="ToDoListId" />
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="form-group">
<label asp-for="Title">İçerik</label>
<input asp-for="Title" class="form-control" type="text" />


<span asp-validation-for="Title" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="ImageUrl">İkon sınıfı (isteğe bağlı)</label>
<input asp-for="ImageUrl" class="form-control" type="text" />

<small class="form-text text-muted">Örnek: la la-check veya fa fa-github</small>
<span asp-validation-for="ImageUrl" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Date">Tarih</label>
<input asp-for="Date" class="form-control" type="date" />


<span asp-validation-for="Date" class="text-danger"></span></div>
<button class="btn btn-primary">Kaydet</button>
<a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form></div></div></div></div>
