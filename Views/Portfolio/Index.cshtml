@model List<Portfolio>
@{
    ViewData["Title"] = "Portfolyo";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="content"><div class="container-fluid">
<h1 class="page-title">Portfolyo</h1>
<div class="card"><div class="card-header"><h2 class="card-title">Portfolyo Yönetimi</h2></div>
<div class="card-body">
<p>Kayıtları buradan ekleyebilir ve düzenleyebilirsin.</p>

<a asp-action="CreatePortfolio" class="btn btn-primary mb-3">Yeni Kayıt Ekle</a>

@if (Model.Count == 0) { <div class="alert alert-info">Henüz kayıt eklenmemiş.</div> }
else {
<div class="table-responsive"><table class="table mt-3"><thead><tr><th>#</th><th>Proje adı</th><th>Kategori</th><th>Görsel yolu</th><th>İşlemler</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.PortfolioId</td><td>@item.Title</td><td>@item.SubTitle</td><td>@item.ImageUrl</td>

<td class="admin-actions">
<a asp-action="UpdatePortfolio" asp-route-id="@item.PortfolioId" class="btn btn-sm btn-success">Güncelle</a>
<form asp-action="DeletePortfolio" asp-route-id="@item.PortfolioId" method="post" class="d-inline" data-confirm-delete>
<button class="btn btn-sm btn-danger">Sil</button></form>
</td></tr>
}
</tbody></table></div>
}
</div></div></div></div>
