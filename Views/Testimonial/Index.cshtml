@model List<Testimonial>
@{
    ViewData["Title"] = "Referanslarım";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="content"><div class="container-fluid">
<h1 class="page-title">Referanslarım</h1>
<div class="card"><div class="card-header"><h2 class="card-title">Referanslarım Yönetimi</h2></div>
<div class="card-body">
<p>Kayıtları buradan ekleyebilir ve düzenleyebilirsin.</p>

<a asp-action="CreateTestimonial" class="btn btn-primary mb-3">Yeni Kayıt Ekle</a>

@if (Model.Count == 0) { <div class="alert alert-info">Henüz kayıt eklenmemiş.</div> }
else {
<div class="table-responsive"><table class="table mt-3"><thead><tr><th>#</th><th>Ad soyad</th><th>Unvan</th><th>Görsel yolu</th><th>İşlemler</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.TestimonialId</td><td>@item.NameSurname</td><td>@item.Title</td><td>@item.ImageUrl</td>

<td class="admin-actions">
<a asp-action="UpdateTestimonial" asp-route-id="@item.TestimonialId" class="btn btn-sm btn-success">Güncelle</a>
<form asp-action="DeleteTestimonial" asp-route-id="@item.TestimonialId" method="post" class="d-inline" data-confirm-delete>
<button class="btn btn-sm btn-danger">Sil</button></form>
</td></tr>
}
</tbody></table></div>
}
</div></div></div></div>
