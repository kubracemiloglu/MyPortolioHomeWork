@model Experience
@{
    ViewData["Title"] = "Deneyimler Ekle";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="content"><div class="container-fluid"><h1 class="page-title">@ViewData["Title"]</h1>
<div class="card"><div class="card-body">
<form asp-action="CreateExperience" method="post">

<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="form-group">
<label asp-for="Head">Firma / kurum</label>
<input asp-for="Head" class="form-control" type="text" />


<span asp-validation-for="Head" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Title">Unvan</label>
<input asp-for="Title" class="form-control" type="text" />


<span asp-validation-for="Title" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Date">Tarih aralığı</label>
<input asp-for="Date" class="form-control" type="text" />


<span asp-validation-for="Date" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Description">Açıklama</label>
<textarea asp-for="Description" rows="5" class="form-control"></textarea>


<span asp-validation-for="Description" class="text-danger"></span></div>
<button class="btn btn-primary">Kaydet</button>
<a asp-action="ExperienceList" class="btn btn-secondary">Vazgeç</a>
</form></div></div></div></div>
