@model About
@{
    ViewData["Title"] = "Hakkımda Güncelle";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="content"><div class="container-fluid"><h1 class="page-title">@ViewData["Title"]</h1>
<div class="card"><div class="card-body">
<form asp-action="UpdateAbout" method="post">
<input type="hidden" asp-for="AboutId" />
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="form-group">
<label asp-for="Title">Başlık</label>
<input asp-for="Title" class="form-control" type="text" />


<span asp-validation-for="Title" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="SubDescription">Kısa açıklama</label>
<textarea asp-for="SubDescription" rows="5" class="form-control"></textarea>


<span asp-validation-for="SubDescription" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Detail">Detay</label>
<textarea asp-for="Detail" rows="5" class="form-control"></textarea>


<span asp-validation-for="Detail" class="text-danger"></span></div>
<button class="btn btn-primary">Kaydet</button>
<a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form></div></div></div></div>
