@model List<About>
@{
    ViewData["Title"] = "Hakkımda";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="content"><div class="container-fluid">
<h1 class="page-title">Hakkımda</h1>
<div class="card"><div class="card-header"><h2 class="card-title">Hakkımda Yönetimi</h2></div>
<div class="card-body">
<p>Bu bilgiler ziyaretçi sayfasındaki ilgili alanda kullanılır.</p>
@if (Model.Count == 0) {
<a asp-action="CreateAbout" class="btn btn-primary mb-3">Yeni Kayıt Ekle</a>
}
@if (Model.Count == 0) { <div class="alert alert-info">Henüz kayıt eklenmemiş.</div> }
else {
<div class="table-responsive"><table class="table mt-3"><thead><tr><th>#</th><th>Başlık</th><th>İşlemler</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.AboutId</td><td>@item.Title</td>

<td class="admin-actions">
<a asp-action="UpdateAbout" asp-route-id="@item.AboutId" class="btn btn-sm btn-success">Güncelle</a>
<form asp-action="DeleteAbout" asp-route-id="@item.AboutId" method="post" class="d-inline" data-confirm-delete>
<button class="btn btn-sm btn-danger">Sil</button></form>
</td></tr>
}
</tbody></table></div>
}
</div></div></div></div>
