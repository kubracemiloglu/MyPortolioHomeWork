@model Contact
@{
    ViewData["Title"] = "İletişim Bilgileri Güncelle";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="content"><div class="container-fluid"><h1 class="page-title">@ViewData["Title"]</h1>
<div class="card"><div class="card-body">
<form asp-action="UpdateContact" method="post">
<input type="hidden" asp-for="ContactId" />
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="form-group">
<label asp-for="Title">Başlık</label>
<input asp-for="Title" class="form-control" type="text" />


<span asp-validation-for="Title" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Description">Açıklama</label>
<textarea asp-for="Description" rows="5" class="form-control"></textarea>


<span asp-validation-for="Description" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Phone1">Telefon (isteğe bağlı)</label>
<input asp-for="Phone1" class="form-control" type="text" />


<span asp-validation-for="Phone1" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Phone2">Diğer telefon (isteğe bağlı)</label>
<input asp-for="Phone2" class="form-control" type="text" />


<span asp-validation-for="Phone2" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Email1">E-posta</label>
<input asp-for="Email1" class="form-control" type="email" />


<span asp-validation-for="Email1" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Email2">Diğer e-posta (isteğe bağlı)</label>
<input asp-for="Email2" class="form-control" type="email" />


<span asp-validation-for="Email2" class="text-danger"></span></div>
<div class="form-group">
<label asp-for="Address">Adres (isteğe bağlı)</label>
<textarea asp-for="Address" rows="5" class="form-control"></textarea>


<span asp-validation-for="Address" class="text-danger"></span></div>
<button class="btn btn-primary">Kaydet</button>
<a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form></div></div></div></div>
