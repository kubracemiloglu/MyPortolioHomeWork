@model List<Feature>
@{
    ViewData["Title"] = "Öne Çıkan Alan";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="content"><div class="container-fluid">
<h1 class="page-title">Öne Çıkan Alan</h1>
<div class="card"><div class="card-header"><h2 class="card-title">Öne Çıkan Alan Yönetimi</h2></div>
<div class="card-body">
<p>Bu bilgiler ziyaretçi sayfasındaki ilgili alanda kullanılır.</p>
@if (Model.Count == 0) {
<a asp-action="CreateFeature" class="btn btn-primary mb-3">Yeni Kayıt Ekle</a>
}
@if (Model.Count == 0) { <div class="alert alert-info">Henüz kayıt eklenmemiş.</div> }
else {
<div class="table-responsive"><table class="table mt-3"><thead><tr><th>#</th><th>Karşılama başlığı</th><th>İşlemler</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.FeatureId</td><td>@item.Title</td>

<td class="admin-actions">
<a asp-action="UpdateFeature" asp-route-id="@item.FeatureId" class="btn btn-sm btn-success">Güncelle</a>
<form asp-action="DeleteFeature" asp-route-id="@item.FeatureId" method="post" class="d-inline" data-confirm-delete>
<button class="btn btn-sm btn-danger">Sil</button></form>
</td></tr>
}
</tbody></table></div>
}
</div></div></div></div>
