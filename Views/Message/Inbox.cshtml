@model List<Message>
@{ ViewData["Title"] = "Gelen Kutusu"; Layout = "~/Views/Layout/Index.cshtml"; }
<div class="content"><div class="container-fluid"><h1 class="page-title">Gelen Kutusu</h1>
<div class="card"><div class="card-body">
<form asp-action="Inbox" method="get" class="form-inline mb-3">
<label class="sr-only" for="messageQuery">Mesajlarda ara</label><input id="messageQuery" name="q" value="@ViewBag.Query" class="form-control mr-2" placeholder="Ad, konu veya mesaj ara"><button class="btn btn-primary">Ara</button><a asp-action="Inbox" class="btn btn-link">Temizle</a></form>
@if (Model.Count == 0) { <p class="alert alert-info">Gösterilecek mesaj bulunamadı.</p> }
else {
<div class="table-responsive"><table class="table"><thead><tr><th>Gönderen</th><th>Konu</th><th>Tarih</th><th>Durum</th><th>İşlemler</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.NameSurname</td><td>@item.Subject</td><td>@item.SendDate.ToString("dd.MM.yyyy HH:mm")</td><td>@(item.IsRead ? "Okundu" : "Okunmadı")</td>
<td class="admin-actions"><a asp-action="MessageDetail" asp-route-id="@item.MessageId" class="btn btn-sm btn-primary">Mesajı Aç</a>
<form asp-action="@(item.IsRead ? "ChangeIsReadToFalse" : "ChangeIsReadToTrue")" asp-route-id="@item.MessageId" method="post" class="d-inline"><button class="btn btn-sm btn-info">@(item.IsRead ? "Okunmadı işaretle" : "Okundu işaretle")</button></form>
<form asp-action="DeleteMessage" asp-route-id="@item.MessageId" method="post" class="d-inline" data-confirm-delete><button class="btn btn-sm btn-danger">Sil</button></form></td></tr>
}
</tbody></table></div>
}
</div></div></div></div>
