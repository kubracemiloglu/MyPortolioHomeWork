@model List<MyPortolioHomeWork.DAL.Entities.Contact>
<section id="contact" class="s-contact target-section">

    <div class="overlay"></div>

    <div class="row narrow section-intro">
        <div class="col-full">
            <h3>İletişim</h3>
            @foreach (var item in Model)
            {
                <h1>@item.Title</h1>
                <p class="lead">@item.Description</p>
            }
        </div>
    </div>
    <div class="row contact__main">
        <div class="col-eight tab-full contact__form">
            @if (TempData["ContactSuccess"] is string success) { <p role="status">@success</p> }
            @if (TempData["ContactError"] is string error) { <p role="alert">@error</p> }
            <form name="contactForm" id="contactForm" method="post" asp-controller="Default" asp-action="SendMessage">
                <fieldset>
                    <div hidden aria-hidden="true"><label for="company">Şirket</label><input name="Company" id="company" tabindex="-1" autocomplete="off"></div>

                    <div class="form-field">
                        <input name="contactName" type="text" id="contactName" placeholder="Ad Soyad" value="" minlength="2" required="" aria-required="true" class="full-width">
                    </div>
                    <div class="form-field">
                        <input name="contactEmail" type="email" id="contactEmail" placeholder="E-posta" value="" required="" aria-required="true" class="full-width">
                    </div>
                    <div class="form-field">
                        <input name="contactSubject" type="text" id="contactSubject" placeholder="Konu" value="" required maxlength="200" class="full-width">
                    </div>
                    <div class="form-field">
                        <textarea name="contactMessage" id="contactMessage" placeholder="Mesajınız" rows="10" cols="50" required="" aria-required="true" class="full-width"></textarea>
                    </div>
                    <div class="form-field">
                        <button type="submit" class="full-width btn--primary" aria-describedby="contactFormNote">Gönder</button>
                        <p id="contactFormNote">Mesajın doğrudan bana iletilir.</p>
                        <div class="submit-loader">
                            <div class="text-loader">Gönderiliyor...</div>
                            <div class="s-loader">
                                <div class="bounce1"></div>
                                <div class="bounce2"></div>
                                <div class="bounce3"></div>
                            </div>
                        </div>
                    </div>

                </fieldset>
            </form>

            <!-- contact-warning -->
            <div class="message-warning">
                Mesaj gönderilemedi. Lütfen tekrar dene.
            </div>

            <!-- contact-success -->
            <div class="message-success">
                Mesajın alındı, teşekkür ederim!<br>
            </div>

        </div>
        <div class="col-four tab-full contact__infos">
            @foreach (var item in Model)
            {
                @if (!string.IsNullOrWhiteSpace(item.Email1))
                {
                    <h4 class="h06">E-posta</h4>
                    <p><a href="mailto:@item.Email1">@item.Email1</a></p>
                }
                @if (!string.IsNullOrWhiteSpace(item.Email2))
                {
                    <p><a href="mailto:@item.Email2">@item.Email2</a></p>
                }
                @if (!string.IsNullOrWhiteSpace(item.Phone1) || !string.IsNullOrWhiteSpace(item.Phone2))
                {
                    <h4 class="h06">Telefon</h4>
                    <p>@item.Phone1<br>@item.Phone2</p>
                }
                @if (!string.IsNullOrWhiteSpace(item.Address))
                {
                    <h4 class="h06">Adres</h4>
                    <p>@item.Address</p>
                }
            }
        </div>
    </div>
</section>
