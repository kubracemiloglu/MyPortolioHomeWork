@model List<MyPortolioHomeWork.DAL.Entities.Testimonial>
@if (Model.Any())
{
<section id="references" class="s-testimonials target-section">
    <div class="overlay"></div>
    <div class="row testimonials-header">
        <div class="col-full">
            <h1 class="h02">Referanslarım</h1>
        </div>
    </div>
    <div class="row testimonials">
        <div class="col-full testimonials__slider">
            @foreach (var item in Model)
            {
                <div class="testimonials__slide @(string.IsNullOrWhiteSpace(item.ImageUrl) ? "reference-without-photo" : "")">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@Url.Content(item.ImageUrl)" alt="@item.NameSurname" class="testimonials__avatar">
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <p>@item.Description</p>
                    }
                    <div class="testimonials__author h06">
                        @item.NameSurname
                        <span>@item.Title</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
}
