@model List<MyPortolioHomeWork.DAL.Entities.Feature>
<section id="home" class="s-home page-hero target-section">

    <div class="overlay"></div>
    <div class="shadow-overlay"></div>
    @foreach(var item in Model)
    {
    <div class="home-content">

        <div class="row home-content__main">
            <div class="hero-eyebrow"><span></span> .NET &amp; BACKEND DEVELOPMENT</div>

            <h3>@item.Title</h3>

            <h1>
                @item.Description
            </h1>
            <p class="hero-summary">C# ve .NET ile veritabanı tabanlı web uygulamaları geliştiriyorum.</p>

            <div class="home-content__buttons">
                <a href="#works" class="smoothscroll btn btn--primary">
                    Son Projelerim
                </a>
                <a href="#about" class="smoothscroll btn btn--stroke">
                    Hakkımda
                </a>
            </div>

            <div class="home-content__scroll">
                <a href="#about" class="scroll-link smoothscroll">
                    <span>Aşağı in</span>
                </a>
            </div>

        </div>
        <div class="hero-art" aria-hidden="true">
            <img src="~/images/portfolio-orbit.svg" alt="" width="600" height="600">
            <div class="hero-art-caption"><span class="hero-art-line"></span> Fikirden çalışan uygulamaya.</div>
        </div>

    </div> <!-- end home-content -->
        
    }

    <ul class="home-social">
        @foreach (var item in ViewBag.socialMedias)
        {
            <li>
                <a href="@item.Url"><i class="@item.Icon" aria-hidden="true"></i><span>@item.Title</span></a>
            </li>
        }
    </ul>
    <!-- end home-social -->

</section> <!-- end s-home -->
