@model List<MyPortolioHomeWork.DAL.Entities.Experience>
<div class="row about-content about-content--buttons">
    <div class="col-six tab-full left">
        <a href="#works" class="btn btn--primary full-width smoothscroll">Projelerimi İncele</a>
    </div>
    <div class="col-six tab-full right">
        <a href="#contact" class="btn full-width smoothscroll">Benimle İletişime Geç</a>
    </div>
</div>
<div class="row about-content about-content--timeline">
    <div class="col-full text-center">
        <h3>Eğitim ve Deneyimlerim</h3>
    </div>
    @for (var column = 0; column < 2; column++)
    {
        <div class="col-six tab-full @(column == 0 ? "left" : "right")">
            <div class="timeline">
                @foreach (var item in Model.Skip(column * ((Model.Count + 1) / 2)).Take((Model.Count + 1) / 2))
                {
                    <div class="timeline__block">
                        <div class="timeline__bullet"></div>
                        <div class="timeline__header">
                            <p class="timeline__timeframe">@item.Date</p>
                            <h3>@item.Head</h3>
                            <h5>@item.Title</h5>
                        </div>
                        <div class="timeline__desc">
                            <p>@item.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>