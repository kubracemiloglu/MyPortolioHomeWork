@model ChangePasswordModel
@{ ViewData["Title"] = "Şifre Değiştir"; Layout = "~/Views/Layout/Index.cshtml"; }
<div class="content"><div class="container-fluid"><h1 class="page-title">@ViewData["Title"]</h1><div class="card"><div class="card-body">

<form asp-action="ChangePassword" method="post">

<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<div class="form-group"><label asp-for="CurrentPassword">Mevcut şifre</label><input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password"><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
<div class="form-group"><label asp-for="NewPassword">Yeni şifre</label><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password"><span asp-validation-for="NewPassword" class="text-danger"></span></div>
<div class="form-group"><label asp-for="ConfirmPassword">Yeni şifre tekrarı</label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password"><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
<button class="btn btn-primary">Kaydet</button>

</form>
</div></div></div></div>
